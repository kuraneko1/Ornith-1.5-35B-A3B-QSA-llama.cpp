diff --git a/src/models/qwen35moe.cpp b/src/models/qwen35moe.cpp
index 235eb3a..7b929ac 100644
--- a/src/models/qwen35moe.cpp
+++ b/src/models/qwen35moe.cpp
@@ -3,6 +3,25 @@
 #include "llama-memory-hybrid-idx.h"
 #include "llama-impl.h"
 
+#include <cstring>
+
+// QSA block-sparse attention (experimental, LLAMA_QSA_SPARSE=1): the k-pool selection is handed to
+// the CUDA qsa-attn kernel as block ids instead of being expanded into a full-KV mask. decode always
+// uses it; prompt batches use it once the cache is long enough for the mask to dominate.
+static bool qsa_sparse_enabled(ggml_type type_k, ggml_type type_v, uint32_t n_seqs_unq, uint32_t kpool) {
+    static const bool enabled = []() {
+        const char * e = getenv("LLAMA_QSA_SPARSE");
+        return e != nullptr && atoi(e) != 0;
+    }();
+    if (!enabled || n_seqs_unq != 1 || kpool != 4) {
+        return false;
+    }
+    if (type_k != GGML_TYPE_F16 && type_k != GGML_TYPE_Q8_0) {
+        return false;
+    }
+    return type_v == type_k;
+}
+
 void llama_model_qwen35moe::load_arch_hparams(llama_model_loader & ml) {
     ml.get_key_or_arr(LLM_KV_EXPERT_FEED_FORWARD_LENGTH, hparams.n_ff_exp_arr, hparams.n_layer_all, false);
     ml.get_key(LLM_KV_EXPERT_SHARED_FEED_FORWARD_LENGTH, hparams.n_ff_shexp, false);
@@ -394,6 +413,8 @@ ggml_tensor * llama_model_qwen35moe::graph::build_layer_attn(
     GGML_ASSERT(n_embd_head == hparams.n_embd_head_k());
 
     const bool qsa = inp_kpool != nullptr && hparams.dsv4_compress_ratios[il] > 0;
+    qsa_sparse_ok = qsa && qsa_sparse_enabled(inp->mctx->type_k(), inp->mctx->type_v(),
